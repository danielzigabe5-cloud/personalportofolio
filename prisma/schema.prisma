datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  demoUrl     String?
  githubUrl   String?
  tags        String?
  createdAt   DateTime @default(now())
}